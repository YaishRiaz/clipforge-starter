# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Never commit these: secrets and credentials
.env
.env.*
!.env.example
*.pem
*.key
client_secret*.json
token*.json

# Working data: database, downloads, renders, logs
data/
out/*
!out/.gitkeep
*.db
*.db-wal
*.db-shm

# Footage: your own recordings and campaign downloads
inbox/*
!inbox/own/
inbox/own/*
!inbox/own/.gitkeep
*.mp4
*.mov
*.mkv

# Campaign logos are per campaign and often licensed; keep them local
assets/logos/*
!assets/logos/.gitkeep

# Taste-book and rubric drafts (approve them first) and rejected drafts
tastebook/*.draft.*
tastebook/*.rejected.*
tastebook/refs/
rubrics/*.draft.json
rubrics/*.rejected.*

# Benchmarks are per machine
docs/benchmark.json
