# Copy to .env and fill in. Never commit .env.

# --- Dashboard (Phase 4) ---
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8787
DASHBOARD_PASSWORD=

# --- LLM: moment scoring, brief parsing, titles (Phase 1+) ---
# The laptop never runs a model locally (PRD section 14). Pick ONE provider.
#
#   groq      - OpenAI-compatible; the free tier serves open-weight models, so
#               this route costs nothing. Needs GROQ_API_KEY.
#   gemini    - Google's OpenAI-compatible endpoint. Needs GEMINI_API_KEY.
#               Free-tier prompts may be used by Google to improve its products.
#   anthropic - the native SDK, best quality. Needs ANTHROPIC_API_KEY.
LLM_PROVIDER=groq

GROQ_API_KEY=
GEMINI_API_KEY=

# WARNING: only ever set ANTHROPIC_API_KEY here, in this file. If you set it as
# a *Windows system environment variable*, Claude Code stops using your Claude
# subscription and bills your API account instead. ClipForge reads this file
# into its own process only, so it cannot affect your Claude Code sessions.
ANTHROPIC_API_KEY=

# Leave both blank to take the provider's default. Run
#   python -m clipforge llm-check
# to list the models your key can actually reach, then paste ids here.
# Brief parsing wants the more capable model; scoring wants a small fast one,
# because there is one call per candidate moment.
LLM_MODEL_BRIEF=
LLM_MODEL_SCORING=

# Only for a provider that is not groq or anthropic (any OpenAI-compatible URL).
LLM_BASE_URL=

# --- YouTube Data API, read-only key: rubric research and stats (Phase 3+) ---
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=
# --- YouTube upload (Phase 5): OAuth Desktop-app client; the refresh token is written
# by `youtube-auth` ---
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# --- Telegram notifications (Phase 4) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Publishing through Buffer (Phase 5) ---
BUFFER_API_KEY=
BUFFER_CHANNEL_ID=

# --- Transcription (Phase 2) ---
# groq  = hosted whisper-large-v3-turbo. Much better than the local base model
#         and much faster than this laptop, but it sends the audio to a third
#         party, which for campaign footage is a licensing decision.
# local = faster-whisper on the CPU, nothing leaves the machine. Measured here
#         at 0.22x real time, so a 5-hour VOD takes about 66 minutes.
# There is no automatic failover between them, on purpose.
TRANSCRIBE_BACKEND=groq
# Groq refuses a file over 25 MB on the free tier. Ten minutes of 16 kHz mono
# FLAC is about 10 MB, so 600 leaves room for a dense passage.
TRANSCRIBE_CHUNK_SECONDS=600
# Only used by the local backend: base, small, medium...
WHISPER_MODEL=base
# PRD section 6: 3-8 moments per source video. The rest are recorded as
# 'dropped' rather than deleted, so the Learn page can see what was passed over.
MOMENTS_PER_SOURCE=8
# How much transcript one request may carry. A provider limit, not a cost
# preference: Groq's free tier allows 8,000 tokens a minute on gpt-oss-120b,
# and a five-hour stream is about 300,000 characters. A transcript over this
# is summarised window by window and those summaries summarised, rather than
# truncated to the opening 5%.
MAX_TRANSCRIPT_CHARS=9000
# gpt-oss models write their reasoning into the completion, and on a
# per-minute token budget the answer costs as much as the question. 'low' is
# right for extraction; blank disables the parameter entirely.
LLM_REASONING_EFFORT=low
# How many parts of a long transcript to summarise, spread evenly. A 5h45
# stream is 44 windows and about 237,000 input tokens, which at 8,000 tokens
# a minute is half an hour of rate limiting -- for a 3-5 sentence summary and
# 6-12 chapters. The moments come from signal peaks over the WHOLE
# transcript, so sampling here costs the pipeline nothing.
SUMMARY_WINDOWS=12
# Optional: a separate key for transcription. Blank falls back to GROQ_API_KEY.
TRANSCRIPTION_API_KEY=

# --- Pipeline limits ---
DISK_FLOOR_GB=15
MAX_SOURCE_HOURS=3
SOURCE_RETENTION_DAYS=7
MAX_HEIGHT=1080
# Leave at 0: fetching a brief page is automated reading of the platform, and
# VERIFY item 10 (do the terms allow it?) is still open. Paste briefs by hand.
ALLOW_BRIEF_FETCH=0

# --- Posting ---
POSTS_PER_DAY=3
POSTS_PER_DAY_CEILING=6
MIN_GAP_HOURS=2
REVIEW_MODE=1
AUTO_SCORE_THRESHOLD=80

# --- Worker ---
WORKER_POLL_SECONDS=5
WORKER_MAX_ATTEMPTS=3
WORKER_RETRY_BACKOFF_SECONDS=60
WORKER_STALL_MINUTES=20
CPU_TEMP_LIMIT_C=85
# PRD section 9 caps peak memory. A job over this is logged as a warning, not
# killed: the point is to find out which stage grew, not to lose the work.
MEMORY_LIMIT_MB=4096

# --- Autopilot (new footage from approved channels) ---
# New channel sources taken per day. The free LLM tier covers about 2 five-hour VODs a day.
SOURCES_PER_DAY=2
# Clips kept ready/approved ahead of posting before more are cut.
CLIP_BUFFER=6
